{
  "id": "https://decisionos-ai-boardroom.vercel.app/",
  "name": "DecisionOS - AI Personal Board of Directors",
  "short_name": "DecisionOS",
  "description": "Autonomous executive AI Personal Board of Directors powered by multi-agent consensus.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait-primary",
  "background_color": "#0b0907",
  "theme_color": "#0b0907",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "business",
    "productivity",
    "utilities",
    "finance"
  ],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.decisionos.app",
      "id": "com.decisionos.app"
    }
  ],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "widgets": [
    {
      "name": "DecisionOS Executive Status",
      "short_name": "DecisionOS",
      "description": "Quick view of active deliberations and consensus",
      "tag": "decisionos-status",
      "template": "widget-template",
      "ms_ac_template": "widget.json",
      "data": "widget-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/screenshot-narrow.png",
          "sizes": "720x1280",
          "label": "Widget preview"
        }
      ],
      "icons": [
        {
          "src": "/decisionos-logo.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "edge_side_panel": {
    "preferred_width": 420
  },
  "note_taking": {
    "new_note_url": "/?mode=new_decision"
  },
  "scope_extensions": [
    {
      "origin": "https://decisionos-ai-boardroom.vercel.app"
    }
  ],
  "launch_handler": {
    "client_mode": "auto"
  },
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+decisionos",
      "url": "/?dilemma=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "text/plain": [".txt", ".md"],
        "application/pdf": [".pdf"],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [".docx"]
      }
    }
  ],
  "icons": [
    {
      "src": "/decisionos-logo.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/decisionos-logo.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New Decision",
      "short_name": "New",
      "description": "Submit a strategic dilemma to your AI Board",
      "url": "/",
      "icons": [{ "src": "/decisionos-logo.png", "sizes": "192x192" }]
    },
    {
      "name": "Memory Vault",
      "short_name": "Vault",
      "description": "View historical board lessons & precedents",
      "url": "/",
      "icons": [{ "src": "/decisionos-logo.png", "sizes": "192x192" }]
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "DecisionOS Executive Cockpit & Boardroom"
    },
    {
      "src": "/screenshot-narrow.png",
      "sizes": "720x1280",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "DecisionOS Mobile Boardroom"
    }
  ]
}
